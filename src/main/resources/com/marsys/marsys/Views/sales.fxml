<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.marsys.marsys.Controllers.SalesController"
            stylesheets="@styles.css">

    <top>
        <HBox spacing="10" style="-fx-background-color: #2c3e50;">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <VBox alignment="CENTER_RIGHT">
                <Label text="Sale" style="-fx-text-fill: red; -fx-font-size: 50px;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="CENTER_RIGHT">
                <Label fx:id="lblUserName" style="-fx-text-fill: white; -fx-font-size: 25px;"/>
                <Label fx:id="lblUserId" style="-fx-text-fill: lightgray; -fx-font-size: 20px;"/>
            </VBox>
        </HBox>
    </top>

    <center>
        <VBox spacing="20">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <Label text="Sale" style="-fx-font-size: 30px; -fx-font-weight: bold;"/>

            <HBox spacing="10">
                <Label text="Barcode: "/>
                <TextField fx:id="barcodeField" promptText="Enter the barcode..."/>
                <Label text="Quantity: "/>
                <TextField fx:id="quantityField" prefWidth="50" prefHeight="25" text="1"/>
                <Button text="Add" onAction="#onAddProduct"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="couponField" promptText="Coupon code"/>
                <Button fx:id="btnApplyCoupon" text="Apply" onAction="#applyCoupon"/>
            </HBox>

            <!-- Satış Listesi Tablosu -->
            <TableView fx:id="salesTable" prefHeight="300">
                <columns>
                    <TableColumn fx:id="colBarcode" text="Barcode"/>
                    <TableColumn fx:id="colProductName" text="Product Name"/>
                    <TableColumn fx:id="colQuantity" text="Quantity"/>
                    <TableColumn fx:id="colCategory" text="Category"/>
                    <TableColumn fx:id="colBrand" text="Brand"/>
                    <TableColumn fx:id="colPrice" text="Price"/>
                    <TableColumn fx:id="colAction" prefWidth="100"/>
                </columns>
            </TableView>


        </VBox>
    </center>

    <bottom>
        <VBox spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 15 10 15 10;">

            <HBox spacing="40" alignment="CENTER_LEFT">
                <Label text="Total:" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Label fx:id="lblTotal" minWidth="80" maxWidth="80"
                       style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>

                <Label text="Discount Total:"
                       style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Label fx:id="lblDiscountTotal" minWidth="80" maxWidth="80"
                       style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>

                <Label text="Last Total:" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Label fx:id="lblLastTotal" minWidth="80" maxWidth="80"
                       style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
            </HBox>
            <HBox spacing="10">

                <Button fx:id="btnBack" text="Back" onAction="#back"
                        style="-fx-text-fill: red; -fx-font-weight: bold;-fx-font-size: 16px;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="Cancel Process" onAction="#cancelProcess"
                        style="-fx-text-fill: red; -fx-font-weight: bold;-fx-font-size: 16px;"/>
                <Button text="Cash Payment" onAction="#cashPayment"
                        style="-fx-text-fill: blue; -fx-font-weight: bold;-fx-font-size: 16px;"/>
                <Button text="Card Payment" onAction="#cardPayment"
                        style="-fx-text-fill: blue; -fx-font-weight: bold;-fx-font-size: 16px;"/>
            </HBox>
        </VBox>


    </bottom>


</BorderPane>
