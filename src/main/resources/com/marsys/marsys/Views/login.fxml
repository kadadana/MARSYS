<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane minHeight="600" minWidth="800"
            xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/17.0.12"
            fx:controller="com.marsys.marsys.Controllers.LoginController"
            stylesheets="@styles.css">

    <top>
        <HBox spacing="10" style="-fx-background-color: #2c3e50;">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <VBox alignment="CENTER_RIGHT">
                <Label text="Login"
                       style="-fx-text-fill: red; -fx-font-size: 50px;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>

        </HBox>
    </top>

    <center>
        <StackPane>
            <VBox alignment="CENTER" spacing="20" style="-fx-font-size: 18px;">
                <padding>
                    <Insets bottom="20" left="20" right="20" top="20" />
                </padding>

                <HBox alignment="CENTER" spacing="10">
                    <Label minWidth="100" text="Store Code:" />
                    <TextField fx:id="storeCodeField" prefHeight="40" prefWidth="300" />
                </HBox>

                <HBox alignment="CENTER" spacing="10">
                    <Label minWidth="100" text="ID:" />
                    <TextField fx:id="idField" prefHeight="40" prefWidth="300" />
                </HBox>

                <HBox alignment="CENTER" spacing="10">
                    <Label minWidth="100" text="Password:" />
                    <PasswordField fx:id="passwordField" prefHeight="40" prefWidth="300" />
                </HBox>

                <Button fx:id="btnLogin" maxWidth="420" onAction="#handleLogin" prefHeight="40" text="Login" />
            </VBox>
        </StackPane>
    </center>

</BorderPane>
