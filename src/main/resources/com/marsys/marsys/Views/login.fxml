<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.marsys.marsys.Controllers.LoginController"
            minWidth="800" minHeight="600">

    <!-- Üst Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #2c3e50;">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label fx:id="lblLogin" text="Log In"
                   style="-fx-font-size: 50px; -fx-text-fill: red;"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <!-- Merkez İçerik -->
    <center>
        <StackPane>
            <VBox fx:id="formContainer" spacing="20" alignment="CENTER">
                <padding>
                    <Insets top="20" bottom="20" left="20" right="20"/>
                </padding>

                <TextField fx:id="storeCodeField" promptText="Store Code"
                           maxWidth="300" prefHeight="40"/>
                <TextField fx:id="idField" promptText="ID"
                           maxWidth="300" prefHeight="40"/>
                <PasswordField fx:id="passwordField" promptText="Password"
                               maxWidth="300" prefHeight="40"/>
                <Button fx:id="btnLogin" text="Login" onAction="#handleLogin"
                        maxWidth="300" prefHeight="40"/>
            </VBox>
        </StackPane>
    </center>

</BorderPane>
