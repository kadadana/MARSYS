<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.marsys.marsys.Controllers.LoginController"
            minWidth="800" minHeight="600">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #2c3e50;">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label text="Log In"
                   style="-fx-font-size: 50px; -fx-text-fill: red;"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <center>
        <StackPane>
            <VBox spacing="20" alignment="CENTER" style="-fx-font-size: 18px;">
                <padding>
                    <Insets top="20" bottom="20" left="20" right="20"/>
                </padding>

                <HBox spacing="10" alignment="CENTER">
                    <Label text="Store Code:" minWidth="100"/>
                    <TextField fx:id="storeCodeField" prefWidth="300" prefHeight="40"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER">
                    <Label text="ID:" minWidth="100"/>
                    <TextField fx:id="idField" prefWidth="300" prefHeight="40"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER">
                    <Label text="Password:" minWidth="100"/>
                    <PasswordField fx:id="passwordField" prefWidth="300" prefHeight="40"/>
                </HBox>

                <Button fx:id="btnLogin" text="Login" onAction="#handleLogin"
                        maxWidth="420" prefHeight="40"/>
            </VBox>
        </StackPane>
    </center>

</BorderPane>
