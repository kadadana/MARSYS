<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>


<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.marsys.marsys.Controllers.DiscountAndCampaignController">

    <!-- Üst bar -->
    <top>
        <HBox spacing="10" style="-fx-background-color: #2c3e50;">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <VBox alignment="CENTER_RIGHT">
                <Label fx:id="lblDiscount" text="Discount And Campaign"
                       style="-fx-text-fill: red; -fx-font-size: 50px;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="CENTER_RIGHT">
                <Label fx:id="lblUserName" style="-fx-text-fill: white; -fx-font-size: 25px;"/>
                <Label fx:id="lblUserId" style="-fx-text-fill: lightgray; -fx-font-size: 20px;"/>
            </VBox>
        </HBox>
    </top>

    <center>

        <VBox spacing="10" alignment="CENTER" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Button fx:id="btnGoToCreateCampaign" minHeight="50.0" minWidth="250.0"
                    onAction="#goToCreateCampaignScreen"
                    text="Create Campaign" textAlignment="CENTER"/>
            <Button fx:id="btnGoToCampaignList" minHeight="50.0" minWidth="250.0" onAction="#goToCampaignList"
                    text="Campaign List" textAlignment="CENTER"/>
            <Button fx:id="btnBack" minHeight="35.0" minWidth="150.0" onAction="#back"
                    text="Back" textAlignment="CENTER"/>
        </VBox>
    </center>

</BorderPane>


