<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>


<?import javafx.util.Callback?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.marsys.marsys.Controllers.CampaignListController">

    <!-- Üst bar -->
    <top>
        <HBox spacing="10" style="-fx-background-color: #2c3e50;">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <VBox alignment="CENTER_RIGHT">
                <Label fx:id="lblDiscount" text="Campaign List"
                       style="-fx-text-fill: red; -fx-font-size: 50px;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="CENTER_RIGHT">
                <Label fx:id="lblUserName" style="-fx-text-fill: white; -fx-font-size: 25px;"/>
                <Label fx:id="lblUserId" style="-fx-text-fill: lightgray; -fx-font-size: 20px;"/>
            </VBox>
        </HBox>
    </top>

    <center>

        <VBox spacing="20">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Campaigns" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

            <!-- Campaign List Table -->
            <TableView fx:id="campaignTable" prefHeight="300">
                <columns>
                    <TableColumn fx:id="colCampaignId" text="Campaign ID" />
                    <TableColumn fx:id="colDiscountType" text="Discount Type" />
                    <TableColumn fx:id="colDiscountValue" text="Discount Value" />
                    <TableColumn fx:id="colStartDate" text="Start Date" />
                    <TableColumn fx:id="colEndDate" text="End Date" />
                    <TableColumn fx:id="colIsActive" text="Is Active" />
                    <TableColumn fx:id="colEdit" text="Edit" prefWidth="100"/>

                </columns>
            </TableView>
            <Button fx:id="btnBack" text="Back" onAction="#back"
                    style="-fx-text-fill: red; -fx-font-weight: bold;-fx-font-size: 16px;"/>
        </VBox>
    </center>

</BorderPane>


